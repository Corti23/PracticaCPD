{
    "info": {
        "name": "CPD API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Disk",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"size\": 100,\n    \"type\": \"SSD\"\n}"
                },
                "url": {
                    "raw": "http://localhost/disks",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "disks"
                    ]
                }
            }
        },
        {
            "name": "Get All Disks",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost/disks",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "disks"
                    ]
                }
            }
        },
        {
            "name": "Get Disks by Id",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost/disks/{id}",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "disks",
                        "{{id}}"
                    ]
                }
            }
        },
        {
            "name": "Delete Disk",
            "request": {
                "method": "DELETE",
                "url": {
                    "raw": "http://localhost/disks/{id}",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "disks",
                        "{{id}}"
                    ]
                }
            }
        },
        {
            "name": "Create Instance",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Test\",\n    \"memory\": 8,\n    \"cores\": 4,\n    \"diskSize\": 50,\n    \"diskType\": \"HDD\"\n}"
                },
                "url": {
                    "raw": "http://localhost/instances",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "instances"
                    ]
                }
            }
        },
        {
            "name": "Get All Instances",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost/instances",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "instances"
                    ]
                }
            }
        },
        {
            "name": "Get Instances by Id",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost/instances/{id}",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "instances",
                        "{{id}}"
                    ]
                }
            }
        },
        {
            "name": "Delete Instance",
            "request": {
                "method": "DELETE",
                "url": {
                    "raw": "http://localhost/instances/{id}",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "path": [
                        "instances",
                        "{{id}}"
                    ]
                }
            }
        }
    ]
